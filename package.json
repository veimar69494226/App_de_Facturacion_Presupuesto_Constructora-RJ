{
  "name": "facturas-app",
  "private": true,
  "version": "0.0.0",
  "description": "Sistema de Facturación RJ (Electron + React)",
  "author": "Ramiro Jimenez Vargas",
  "type": "module",
  "main": "src/electron/main.cjs",
  "scripts": {
    "vite:dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev": "npm run electron:dev",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "bootstrap-icons": "^1.13.1",
    "dictionary-es": "^4.0.0",
    "lucide-react": "^0.564.0",
    "nspell": "^2.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.0.0-beta.13",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "build": {
    "appId": "com.ramiro.facturacion",
    "productName": "Sistema Facturacion RJ",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "src/electron/**",
      "node_modules/dictionary-es/**",
      "node_modules/nspell/**",
      "node_modules/is-buffer/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "build/logo constructora.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Facturacion RJ"
    }
  }
}
